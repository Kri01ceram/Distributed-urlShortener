generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Url {
  id        BigInt   @id @default(autoincrement())
  shortCode String   @unique
  longUrl   String
  createdAt DateTime @default(now())
  expiresAt DateTime?

  @@index([shortCode])
}